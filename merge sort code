def merge_sort(arr):
    """Sorts the array using the Merge Sort algorithm."""
    if len(arr) <= 1:
        return arr  # Base case: already sorted

    mid = len(arr) // 2
    left_half = merge_sort(arr[:mid])
    right_half = merge_sort(arr[mid:])

    return merge(left_half, right_half)


def merge(left, right):
    """Merges two sorted lists into one sorted list."""
    merged = []
    i = j = 0

    # Merge elements in sorted order
    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            merged.append(left[i])
            i += 1
        else:
            merged.append(right[j])
            j += 1

    # Append remaining elements
    merged.extend(left[i:])
    merged.extend(right[j:])
    return merged


def main():
    try:
        # User input
        raw_input = input("Enter elements separated by spaces: ").strip()
        if not raw_input:
            print("No input provided.")
            return

        # Try converting to numbers if possible
        elements = raw_input.split()
        try:
            # Convert to float if all are numbers
            elements = [float(x) if '.' in x else int(x) for x in elements]
        except ValueError:
            # Keep as strings if not all are numbers
            pass

        sorted_list = merge_sort(elements)
        print("Sorted list:", sorted_list)

    except Exception as e:
        print("An error occurred:", e)


if __name__ == "__main__":
    main()
